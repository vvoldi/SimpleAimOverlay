<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SimpleAimOverlay</AssemblyName>
    <AssemblyTitle>Simple Aim Overlay</AssemblyTitle>
    <Product>Simple Aim Overlay</Product>
    <Description>A lightweight, configurable Windows crosshair overlay.</Description>
    <Authors>SimpleAimOverlay contributors</Authors>
    <Version>0.2.3</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\simple-aim-overlay.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(UseUiAccess)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(UseUiAccess)' == 'true'">app.uiaccess.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><Compile Remove="packaging/**/*.cs" /><Compile Remove="tests/**/*.cs" /><EmbeddedResource Remove="packaging/**/*" /><None Remove="packaging/**/*" />
    <EmbeddedResource Include="Assets\Fonts\Inter-Variable.ttf" LogicalName="SimpleAimOverlay.Assets.Fonts.Inter-Variable.ttf" />
    <EmbeddedResource Include="Assets\Fonts\OFL.txt" LogicalName="SimpleAimOverlay.Assets.Fonts.OFL.txt" />
    <EmbeddedResource Include="Assets\simple-aim-overlay.ico" LogicalName="SimpleAimOverlay.Assets.simple-aim-overlay.ico" />
    <None Include="Assets\simple-aim-overlay.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
