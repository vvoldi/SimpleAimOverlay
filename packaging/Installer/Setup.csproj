<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>SimpleAimOverlay-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest><PublishSingleFile>true</PublishSingleFile><SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract><EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>0.2.6</Version><Product>Simple Aim Overlay Setup</Product>
    <ApplicationIcon>..\..\Assets\simple-aim-overlay.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../AppFonts.cs" Link="AppFonts.cs" /><EmbeddedResource Include="../../Assets/Fonts/Inter-Variable.ttf" LogicalName="SimpleAimOverlay.Assets.Fonts.Inter-Variable.ttf" /><Compile Include="../../Dialogs.cs" Link="Dialogs.cs" />
    <EmbeddedResource Include="SimpleAimOverlay.payload.exe" LogicalName="payload.exe" />
    <EmbeddedResource Include="SimpleAimOverlay.Test.cer" LogicalName="test.cer" />
    <EmbeddedResource Include="..\..\Assets\simple-aim-overlay.ico" LogicalName="app.ico" />
  </ItemGroup>
<ItemGroup><Compile Include="..\..\RoundedUi.cs" Link="RoundedUi.cs" /></ItemGroup><ItemGroup><Compile Include="..\..\UiText.cs" Link="UiText.cs" /></ItemGroup><ItemGroup><Compile Include="../../ThemePalette.cs" Link="ThemePalette.cs" /></ItemGroup></Project>
